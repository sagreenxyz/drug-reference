---
import Layout from '../layouts/Layout.astro';
import { drugReferences } from '../data/references/drugs.js';
import { assessmentTools, clinicalGuidelines } from '../data/references/assessment-tools.js';
---

<Layout title="Drug Reference" description="Clinical drug reference for nursing students — medications, assessment tools, and clinical guidelines">
  <!-- Hero -->
  <div class="mb-12 text-center py-12 px-4 bg-gradient-to-br from-medical-50 to-teal-50 rounded-2xl border border-medical-100">
    <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-medical-600 to-teal-600 flex items-center justify-center mx-auto mb-6 shadow-lg">
      <svg class="w-9 h-9 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
      </svg>
    </div>
    <h1 class="text-4xl font-bold text-slate-800 mb-3">Drug Reference</h1>
    <p class="text-lg text-slate-500 max-w-2xl mx-auto mb-8">
      Comprehensive clinical pharmacology reference for nursing students — medications, assessment tools, and evidence-based clinical guidelines.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href={`${import.meta.env.BASE_URL}/drugs`}
        class="px-6 py-3 bg-medical-600 text-white rounded-xl font-medium hover:bg-medical-700 transition-colors shadow-sm"
      >
        💊 Browse Drugs ({drugReferences.length})
      </a>
      <a
        href={`${import.meta.env.BASE_URL}/references`}
        class="px-6 py-3 bg-white text-medical-700 border border-medical-200 rounded-xl font-medium hover:bg-medical-50 transition-colors shadow-sm"
      >
        📋 Clinical References
      </a>
    </div>
  </div>

  <!-- Disclaimer -->
  <div class="mb-10 p-4 bg-amber-50 border border-amber-200 rounded-xl flex items-start gap-3">
    <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
    </svg>
    <div class="text-sm text-amber-800">
      <strong>Educational Use Only:</strong> This reference material is provided for educational purposes.
      Always verify medication doses, guidelines, and clinical decisions against current institutional protocols, pharmacy resources, and the most recent evidence-based literature in actual clinical practice.
    </div>
  </div>

  <!-- Stats -->
  <div class="grid sm:grid-cols-3 gap-4 mb-12">
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-medical-100 flex items-center justify-center text-2xl flex-shrink-0">💊</div>
      <div>
        <div class="text-2xl font-bold text-slate-800">{drugReferences.length}</div>
        <div class="text-sm text-slate-500">Drug References</div>
      </div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-teal-100 flex items-center justify-center text-2xl flex-shrink-0">📋</div>
      <div>
        <div class="text-2xl font-bold text-slate-800">{assessmentTools.length}</div>
        <div class="text-sm text-slate-500">Assessment Tools</div>
      </div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center text-2xl flex-shrink-0">📌</div>
      <div>
        <div class="text-2xl font-bold text-slate-800">{clinicalGuidelines.length}</div>
        <div class="text-sm text-slate-500">Clinical Guidelines</div>
      </div>
    </div>
  </div>

  <!-- Quick Access - Drug Classes -->
  <div class="mb-12">
    <h2 class="text-xl font-bold text-slate-800 mb-4">Browse by Drug Class</h2>
    <div class="flex flex-wrap gap-2">
      {[...new Set(drugReferences.map(d => d.class))].sort().map((cls) => (
        <a
          href={`${import.meta.env.BASE_URL}/drugs#${cls.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          class="px-3 py-1.5 text-xs font-medium bg-white border border-slate-200 rounded-full text-slate-600 hover:border-medical-300 hover:text-medical-700 hover:bg-medical-50 transition-colors"
        >
          {cls}
        </a>
      ))}
    </div>
  </div>

  <!-- Featured Sections -->
  <div class="grid md:grid-cols-2 gap-6">
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-8 h-8 rounded-lg bg-medical-100 flex items-center justify-center text-lg">💊</div>
        <h2 class="text-lg font-bold text-slate-800">Drug Reference</h2>
      </div>
      <p class="text-sm text-slate-500 mb-4">Detailed drug monographs including doses, routes, contraindications, side effects, nursing considerations, and monitoring parameters.</p>
      <a href={`${import.meta.env.BASE_URL}/drugs`} class="text-sm font-medium text-medical-600 hover:text-medical-700 transition-colors">
        View all {drugReferences.length} drugs →
      </a>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-8 h-8 rounded-lg bg-teal-100 flex items-center justify-center text-lg">📋</div>
        <h2 class="text-lg font-bold text-slate-800">Clinical References</h2>
      </div>
      <p class="text-sm text-slate-500 mb-4">Assessment tools (SBAR, GCS, qSOFA), clinical guidelines (Sepsis, STEMI), and normal reference values for vital signs and lab values.</p>
      <a href={`${import.meta.env.BASE_URL}/references`} class="text-sm font-medium text-teal-600 hover:text-teal-700 transition-colors">
        View clinical references →
      </a>
    </div>
  </div>
</Layout>
